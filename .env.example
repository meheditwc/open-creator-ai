# ─────────────────────────────────────────────────────────────────────────────
# Open Creator AI — environment
# Copy to .env and adjust. Every value is optional: the studio runs without it.
# ─────────────────────────────────────────────────────────────────────────────

# Daemon
PORT=9861
OPENCREATOR_HOST=127.0.0.1
OPENCREATOR_DATA_DIR=.runtime
# Comma separated list of allowed browser origins ("*" allows any)
OPENCREATOR_CORS=*

# Studio dev server: extra hostnames it should answer to (comma separated).
# Use "*" for sandboxes with a dynamic preview hostname, ".example.com" for a
# domain and all of its subdomains.
# OPENCREATOR_ALLOWED_HOSTS=.e2b.app

# ── Model provider ──────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works: a local router, Ollama, LM Studio,
# LiteLLM, vLLM or a hosted API.
#
# FreeLLMAPI (free LLM routing, self-hosted):
#   docker run -d -p 3001:3001 ghcr.io/tashfeenahmed/freellmapi:latest
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=

# Model names used by the agent
OPENCREATOR_MODEL=gpt-4o-mini
OPENCREATOR_FAST_MODEL=gpt-4o-mini

# ── Media binaries ──────────────────────────────────────────────────────────
# ffmpeg renders every image and video the studio produces. If it is not on your
# PATH, run `npm run setup:media` (writes apps/daemon/.bin/ffmpeg) and leave this
# on the default so it is picked up automatically.
FFMPEG_PATH=ffmpeg
# Used by Video Downloader only.
YTDLP_PATH=yt-dlp
WHISPER_MODEL=base
# Font used for rendered text (needs DejaVu Sans or a similar sans-serif).
OPENCREATOR_FONT=DejaVu Sans

# ── Optional speech (voiceovers / dubbing only) ─────────────────────────────
# Uses the OpenAI-compatible /audio/speech endpoint of FREELLMAPI_BASE_URL.
OPENCREATOR_TTS_MODEL=tts-1
OPENCREATOR_TTS_VOICE=alloy
